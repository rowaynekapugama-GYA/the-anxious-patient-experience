# The Anxious Patient Experience: environment variables for Vercel.
# Add them in Vercel > Project > Settings > Environment Variables (Production and Preview), then redeploy.
# This file is only a template. Never commit real keys or passwords.

# --- Database (required for the dashboard and bookings) ---
# Neon Postgres: Vercel > Storage > Neon > connect to this project. Adds DATABASE_URL by itself.
DATABASE_URL=

# --- Dashboard (required once DATABASE_URL is set) ---
# Signs dashboard sessions. Any random string of 32 characters or more (openssl rand -hex 32). Changing it signs
# everyone out. The build stops if DATABASE_URL is set and this is missing.
PAYLOAD_SECRET=
# Photos uploaded in the dashboard: Vercel > Storage > Blob > connect to this project. Adds this by itself.
BLOB_READ_WRITE_TOKEN=
# The Publish website button: Vercel > Settings > Git > Deploy Hooks (branch main).
PUBLISH_HOOK_URL=
# true only while the very first (GYA administrator) login is made on /admin/login, then delete it and redeploy.
ALLOW_FIRST_USER=
# The address the dashboard and the canonical links use. Leave unset on vercel.app; at go-live the domain, no slash.
NEXT_PUBLIC_SERVER_URL=

# --- Dashboard logins (v1.6.0) ---
# Who can sign in to /admin as an Editor, comma separated. On each production build, any address here without a login
# gets one and is emailed a link to choose a password. Removing an address does NOT delete the login (do that under
# Users). GYA administrators are added under Users, not here.
DASHBOARD_EDITORS=lorna-gladwin1@hotmail.co.uk,reception@thecaringbahdentists.com.au,reception@thecronulladentists.com.au,theanxiouspatientexperience@gmail.com

# --- Emails: booking requests, patient acknowledgements, password links (required for online booking) ---
# One provider: SMTP2GO (the GYA standard) or Resend. If both are set, SMTP2GO is used.
SMTP2GO_API_KEY=
RESEND_API_KEY=
# The sender, on a domain verified with that provider (a gmail.com address cannot be used), for example:
# BOOKING_FROM=The Anxious Patient Experience <bookings@thecronulladentists.com.au>
BOOKING_FROM=
# Where booking requests go if Site Settings has no list. Comma separated. Defaults to the APE inbox.
BOOKING_NOTIFY_EMAIL=theanxiouspatientexperience@gmail.com
# Optional: extra copies of each request, comma separated
BOOKING_BCC=

# --- Deposit: PayPal (v1.8.0) ---
# The $100 deposit is paid inside Book Now with PayPal Checkout (PayPal or card, no PayPal account needed). Without
# PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET the deposit step is not offered and patients are told the details come with
# their confirmation. Preview uses the sandbox app, Production the live app (docs/PAYPAL-SETUP.md).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The webhook created in the same app (https://YOUR-DOMAIN/api/paypal/webhook, events PAYMENT.CAPTURE.COMPLETED,
# PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED). Used to verify each event. Refunds made in PayPal show in the
# dashboard through it.
PAYPAL_WEBHOOK_ID=
# Payout bank details are entered in the PayPal account only, never here.
# v1.10.0: PayPal Advanced Checkout (card fields on the page, Apple Pay, Google Pay; the PayPal button stays). Leave
# unset (off) until PayPal has approved the account for Advanced Checkout and Apple Pay and Google Pay are turned on in
# the app (docs/PAYPAL-ADVANCED-SETUP.md). Then "on" in Preview first, test, then Production. Not sensitive.
PAYPAL_ADVANCED=
# v1.10.0: the Apple Pay domain check file PayPal gives when the domain is registered. Optional: the file can instead go
# in config/apple-pay/. Until one of them is set, /.well-known/apple-developer-merchantid-domain-association is a 404.
# Public by design, not sensitive.
APPLE_PAY_DOMAIN_ASSOCIATION=
# v1.11.0: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Optional: the usual place is the dashboard, Site Settings >
# Tracking, which wins over this. Leave unset until Lorna approves the analytics paragraph in the privacy policy. Public
# by design (it is in every page), not sensitive. Never loads on /admin, /cms, the questionnaire or vercel.app.
NEXT_PUBLIC_GA4_ID=

# --- Welcome pack and online questionnaire (v1.7.0, reworked v1.9.0) ---
# Both are switched on in the dashboard (Site Settings > Welcome pack, GYA only), not here.
# Leave QUESTIONNAIRE_ENABLED unset. Setting it to false is an emergency off switch for the online questionnaire
# (redeploy to apply); true does nothing on its own.
QUESTIONNAIRE_ENABLED=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts questionnaire answers (and answers saved to finish
# later). Production and Preview, marked Sensitive. NEVER change it once answers exist (they could not be read back).
# Keep a copy in the GYA password manager. The online questionnaire cannot be switched on without it.
# v1.13.0: Lorna approved the questionnaire on 19 Nov 2026, so adding this key (and redeploying) is what puts it live.
# There is no key rotation: one key for all answers. Never put the real value in this file or in git.
QUESTIONNAIRE_ENCRYPTION_KEY=
# v1.18.0: treatment plans. 32 random bytes, base64 (openssl rand -base64 32), a separate key from the questionnaire's.
# Production and Preview, Sensitive. Never change it once plans exist; keep a copy in the GYA password manager.
# Treatment plans stay off until this is set, Lorna has approved the form, the privacy policy has its treatment plan
# section and someone has the permission. Never put the real value in this file or in git.
TREATMENT_PLAN_ENCRYPTION_KEY=
# false is an emergency off switch for treatment plans (redeploy to apply); true does nothing on its own.
TREATMENT_PLANS_ENABLED=
