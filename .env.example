# The Anxious Patient Experience: environment variables for Vercel.
# Add them in Vercel > Project > Settings > Environment Variables (Production and Preview), then redeploy.
# This file is only a template. Never commit real keys or passwords.

# --- Database (required for the dashboard and bookings) ---
# Neon Postgres: Vercel > Storage > Neon > connect to this project. Adds DATABASE_URL by itself.
DATABASE_URL=

# --- Dashboard (required once DATABASE_URL is set) ---
# Signs dashboard sessions. Any random string of 32 characters or more (openssl rand -hex 32). Changing it signs
# everyone out. The build stops if DATABASE_URL is set and this is missing.
PAYLOAD_SECRET=
# Photos uploaded in the dashboard: Vercel > Storage > Blob > connect to this project. Adds this by itself.
BLOB_READ_WRITE_TOKEN=
# The Publish website button: Vercel > Settings > Git > Deploy Hooks (branch main).
PUBLISH_HOOK_URL=
# true only while the first dashboard login is made on /admin/login, then delete it and redeploy.
ALLOW_FIRST_USER=
# The address the dashboard and the canonical links use. Leave unset on vercel.app; at go-live the domain, no slash.
NEXT_PUBLIC_SERVER_URL=

# --- Booking emails (required for online booking) ---
# Resend API key (https://resend.com > API Keys)
RESEND_API_KEY=
# Sender on a domain verified in Resend, for example:
# BOOKING_FROM=The Anxious Patient Experience <bookings@yourdomain.com.au>
BOOKING_FROM=
# Where booking requests are sent if Site Settings has no list (defaults to the APE inbox)
BOOKING_NOTIFY_TO=theanxiouspatientexperience@gmail.com
# Optional: extra copies of each request, comma separated
BOOKING_BCC=

# --- Deposit (optional until Ram confirms the account) ---
# A payment link for the $100 deposit, for example a Stripe Payment Link (https://buy.stripe.com/...).
# The booking reference and the patient's email are added to it automatically.
DEPOSIT_PAYMENT_URL=
