# Booking request emails (api/booking.js). Add these in Vercel > Settings > Environment Variables (Production and
# Preview), then redeploy. Never commit real keys: this file is only a template.

# Resend API key (https://resend.com > API Keys)
RESEND_API_KEY=

# Where booking requests are sent (defaults to this address if left out)
BOOKING_NOTIFY_TO=theanxiouspatientexperience@gmail.com

# Sender for both emails. Must be on a domain verified in Resend, for example:
# BOOKING_FROM=The Anxious Patient Experience <bookings@theanxiouspatientexperience.com.au>
BOOKING_FROM=

# Optional: extra copies of each request, comma separated (left empty on purpose, see README)
BOOKING_BCC=
