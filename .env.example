# The Anxious Patient Experience: environment variables for Vercel.
# Add them in Vercel > Project > Settings > Environment Variables (Production and Preview), then redeploy.
# This file is only a template. Never commit real keys or passwords.

# --- Database (required for bookings and the dashboard) ---
# Neon Postgres. Easiest: Vercel > Project > Storage > Create Database > Neon > Connect to this project.
# Vercel then adds DATABASE_URL by itself. Tables are created automatically on first use.
DATABASE_URL=

# --- Dashboard (required) ---
# The password Lorna and the APE team use at /admin/. At least 8 characters; 12 or more recommended.
# Changing it signs everyone out.
ADMIN_PASSWORD=

# --- Booking emails (required) ---
# Resend API key (https://resend.com > API Keys)
RESEND_API_KEY=
# Sender for both emails. Must be on a domain verified in Resend, for example:
# BOOKING_FROM=The Anxious Patient Experience <bookings@yourdomain.com.au>
BOOKING_FROM=
# Where booking requests are sent (defaults to this address if left out)
BOOKING_NOTIFY_TO=theanxiouspatientexperience@gmail.com
# Optional: extra copies of each request, comma separated (left empty on purpose, see README)
BOOKING_BCC=

# --- Deposit (optional until Ram confirms the account) ---
# A payment link for the $100 deposit, for example a Stripe Payment Link (https://buy.stripe.com/...).
# The booking reference and the patient's email are added to it automatically.
# Leave empty and patients are told "Deposit details will be sent with your confirmation."
DEPOSIT_PAYMENT_URL=
